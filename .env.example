# Copy to .env.development / .env.test / .env.production / .env.localapi and adjust.
#
# VITE_API_MODE  mock | http
#   mock -> deterministic in-memory data, no backend needed (local development)
#   http -> HTTP adapter against the API
#
# VITE_API_PORT  Port of the API on the SAME host that serves this dashboard.
#   Used when VITE_API_URL is absent, so one build works from the internal
#   network (http://192.168.1.15/... -> http://192.168.1.15:8070/) and from
#   the internet (http://138.117.6.44/... -> http://138.117.6.44:8070/).
#
# VITE_API_URL   Full base URL, optional override (local API and special cases).
#   When present it wins and VITE_API_PORT is ignored.
#
# Only API URLs belong here. Never put database passwords, connection
# strings or tokens in this frontend: the dashboard only talks to the API.
VITE_API_MODE=mock
VITE_API_PORT=8070
# VITE_API_URL=http://localhost:5029/
